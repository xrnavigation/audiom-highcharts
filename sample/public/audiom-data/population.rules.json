{
  "version": 2,
  "rules": [
    {
      "id": "choropleth-population-with-value",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "ruleType"
          ],
          "choropleth_region"
        ],
        [
          "has",
          "value"
        ]
      ],
      "output": {
        "ruleType": "choropleth_region",
        "name": [
          "concat",
          [
            "coalesce",
            [
              "get",
              "name"
            ],
            "Unknown country"
          ],
          ", ",
          [
            "to-string",
            [
              "get",
              "value"
            ]
          ],
          " million people"
        ],
        "ruleName": "",
        "passable": true,
        "fill": [
          "step",
          [
            "to-number",
            [
              "get",
              "value"
            ]
          ],
          "#F7F7FF",
          2.4946602519952057,
          "#D8D8FF",
          6.223329772884783,
          "#B5B5FF",
          15.525093419474022,
          "#8C8CFF",
          38.72983346207417,
          "#5C5CFF",
          96.61777610423029,
          "#3333DD",
          241.02852568339557,
          "#1F1FAA",
          601.2842826193722,
          "#101077",
          1500,
          "#000033"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "choropleth-population-no-value",
      "filter": [
        "==",
        [
          "get",
          "ruleType"
        ],
        "choropleth_region"
      ],
      "output": {
        "ruleType": "choropleth_region",
        "name": [
          "concat",
          [
            "coalesce",
            [
              "get",
              "name"
            ],
            "Unknown country"
          ],
          " (no population data)"
        ],
        "ruleName": "",
        "passable": true,
        "fill": "#DDDDDD",
        "fill-opacity": 0.85
      }
    }
  ],
  "augmenters": []
}