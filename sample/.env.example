# Copy this file to `sample/.env.local` and fill in real values.
# `.env.local` is gitignored; this `.env.example` is committed.

# Public demo key for the shared Audiom embed used by every sample page.
# It is intentionally public (Audiom can rotate it server-side); we keep
# it out of source so a leaked key can be replaced without a code change.
VITE_AUDIOM_SHARED_API_KEY=wO35blaGsjJREGuXehqWU

# --- Optional: direct-to-Audiom REST upload mode --------------------------
# When VITE_AUDIOM_API_URL and VITE_AUDIOM_API_KEY are both set, the sample
# uploads its extracted GeoJSON straight to Audiom's REST API instead of
# the in-process dev-server backend.
#
# VITE_AUDIOM_API_URL=https://api.audiom.app
# VITE_AUDIOM_API_KEY=
# VITE_AUDIOM_FRONTEND_URL=https://app.audiom.app
# VITE_AUDIOM_ORG_ID=42 # Optional
